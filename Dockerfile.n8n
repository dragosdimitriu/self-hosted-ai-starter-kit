# Use Node.js Alpine as base, then install n8n and Python
FROM node:20-alpine

# Install Python 3 and pip
RUN apk add --no-cache python3 py3-pip

# Install n8n globally
RUN npm install -g n8n

# Set working directory (node user already exists in node:20-alpine)
WORKDIR /home/node

# Switch to node user
USER node

# Set n8n environment variables
ENV N8N_USER_FOLDER=/home/node/.n8n
ENV N8N_HOST=0.0.0.0
ENV N8N_PORT=5678
ENV N8N_PROTOCOL=http

# Expose n8n port
EXPOSE 5678

# Start n8n
ENTRYPOINT ["n8n"]

